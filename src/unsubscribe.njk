<article class="page wrap-narrow">
  <header class="page-head">
    <p class="kicker">Newsletter</p>
    <h1 class="page-title">Unsubscribe</h1>
    <p class="dek">Enter the address you subscribed with and you are off the list. No questions asked.</p>
  </header>
  <div class="article-body">
    <form class="signup-form" name="unsubscribe" method="POST" action="/newsletter/unsubscribed/" data-netlify="true" netlify-honeypot="website">
      <input type="hidden" name="form-name" value="unsubscribe">
      <p class="visually-hidden"><label>Leave this empty: <input name="website" tabindex="-1" autocomplete="off"></label></p>
      <label class="visually-hidden" for="unsub-email">Email address</label>
      <input type="email" name="email" id="unsub-email" placeholder="you@example.com" required autocomplete="email" data-prefill="e">
      <button type="submit">Unsubscribe</button>
    </form>
    <p class="signup-fine">Removal is processed within the day and you get one short confirmation. If anything goes wrong, <a href="/contact/">tell us</a> and a person will remove you by hand.</p>
  </div>
</article>
